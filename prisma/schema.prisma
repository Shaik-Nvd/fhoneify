generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String              @id @default(uuid())
  phone        String              @unique
  role         String              @default("user")
  email        String?             @unique
  referralCode String?             @unique
  referredBy   String?
  name         String?
  buyOrders    BuyOrder[]
  listings     Listing[]
  pickups      Pickup[]
  sellOrders   SellOrder[]
  walletLedger WalletLedgerEntry[]
}

model Device {
  id        String          @id @default(uuid())
  brand     String
  model     String
  storage   String
  ram       String
  color     String
  inventory InventoryItem[]
  quotes    Quote[]
}

model Listing {
  id           String      @id @default(uuid())
  userId       String
  deviceId     String
  brand        String
  model        String
  storage      String?
  condition    String
  price        Float
  status       String      @default("active")
  city         String
  description  String?
  images       String
  isSelectTier Boolean     @default(false)
  locationId   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id])
  pickups      Pickup[]
  sellOrders   SellOrder[]
}

model Quote {
  id             String   @id @default(uuid())
  deviceId       String
  condition      String
  estimatedPrice Float
  createdAt      DateTime @default(now())
  device         Device   @relation(fields: [deviceId], references: [id])
}

model BuyOrder {
  id              String   @id @default(uuid())
  userId          String
  listingIds      String
  status          String   @default("pending")
  address         String
  razorpayOrderId String?
  totalPrice      Float?
  discount        Float?
  finalPrice      Float?
  couponCode      String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

model SellOrder {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  status    String   @default("pending")
  price     Float
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model WalletLedgerEntry {
  id            String   @id @default(uuid())
  userId        String
  amount        Float
  type          String
  description   String
  balance_after Float
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

model Pickup {
  id         String   @id @default(uuid())
  userId     String
  listingId  String
  pickupDate String
  timeSlot   String
  address    String
  status     String   @default("scheduled")
  createdAt  DateTime @default(now())
  listing    Listing  @relation(fields: [listingId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model Coupon {
  code          String  @id
  discountType  String
  discountValue Float
  description   String
  isActive      Boolean @default(true)
}

model Store {
  id           String  @id @default(uuid())
  name         String
  city         String
  address      String
  phone        String
  workingHours String
  lat          Float
  lng          Float
  mapLink      String?
}

model TechFloat {
  id     String @id @default(uuid())
  techId String @unique
  cash   Float  @default(0)
  upi    Float  @default(0)
}

model ActivePickup {
  id                String @id @default(uuid())
  techId            String
  customerName      String
  device            String
  declaredCondition String
  originalQuote     Float
  status            String @default("assigned")
  address           String
}

model InventoryItem {
  id              String   @id @default(uuid())
  deviceId        String
  imei            String
  sourceListingId String?
  phase           String   @default("received")
  grade           String?
  createdAt       DateTime @default(now())
  device          Device   @relation(fields: [deviceId], references: [id])
}

model BlogPost {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  content        String
  author         String
  tags           String
  published      Boolean  @default(true)
  seoTitle       String
  seoDescription String
  createdAt      DateTime @default(now())
}

model Lead {
  id          String   @id @default(uuid())
  userId      String?
  name        String?
  phone       String
  brand       String
  model       String
  storage     String
  quotedPrice Float
  pickupDate  String?
  pickupTime  String?
  address     String?
  pincode     String?
  city        String?
  status      String   @default("pending")
  answers     Json?
  createdAt   DateTime @default(now())
}

model WhatsAppOTP {
  id        String   @id @default(uuid())
  phone     String   @unique
  /// HMAC of the one-time code, never the code itself: a database dump (or a
  /// support user with read access) must not be able to complete someone's
  /// login. Verification re-computes the HMAC and compares in constant time.
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// Failed verification attempts for the current code. The code is destroyed
  /// once this reaches the limit, so a 6-digit code cannot be brute-forced
  /// within its lifetime.
  attempts  Int      @default(0)
}

// --- Reference pricing infrastructure ---
// See PRICING_REFERENCE_DATA_ARCHITECTURE.md. These models are the target
// Postgres schema for the reference-price lifecycle; they are NOT yet
// migrated to a live database (blocked on a real DATABASE_URL - see
// PRODUCTION_READINESS_REPORT.md Blocking Questions). The current
// implementation backs the same repository interface with a durable
// file-based store (lib/referencePricing/store.ts) so behavior and data
// shape are already correct and this migration is a backing-store swap,
// not a redesign, once Postgres access exists.

enum ReferencePriceStatus {
  FRESH
  APPROACHING_STALE
  STALE
  MISSING
  REFRESH_FAILED
}

enum MatchConfidence {
  EXACT
  HIGH
  AMBIGUOUS
  UNMATCHED
}

model ReferencePrice {
  id               String               @id @default(uuid())
  // deviceKey is the canonical, stable identifier for a specific
  // brand+model+storage variant (see lib/referencePricing/matching.ts).
  // It is NOT the same as seed_devices.ts's random "id" field, so it
  // survives seed-data reshuffling.
  deviceKey        String               @unique
  brand            String
  model            String
  storage          String
  source           String // e.g. "cashify" - which external reference this came from
  sourceUrl        String?
  currentPrice     Float // NOTE: Float mirrors the existing schema's money
  // handling elsewhere (see PRODUCTION_READINESS_AUDIT.md's money-as-Float
  // finding on WalletLedgerEntry/BuyOrder) - not changed here to avoid a
  // second, disconnected money-representation decision; both should move
  // to Int-minor-units/Decimal together as part of the Phase 2 DB migration.
  matchConfidence  MatchConfidence
  matchEvidence    String? // human-readable note on how the match was made
  status           ReferencePriceStatus @default(MISSING)
  lastVerifiedAt   DateTime? // last time a refresh SUCCEEDED
  lastAttemptedAt  DateTime? // last time a refresh was ATTEMPTED (success or fail)
  lastFailureAt    DateTime?
  lastFailureError String?
  consecutiveFailures Int    @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  history          ReferencePriceHistory[]

  @@index([status])
  @@index([brand, model])
}

model ReferencePriceHistory {
  id               String         @id @default(uuid())
  referencePriceId String
  referencePrice   ReferencePrice @relation(fields: [referencePriceId], references: [id])
  price            Float
  recordedAt       DateTime       @default(now())
  source           String
  note             String? // e.g. "legacy migration from oppo_prices.json (git commit 2026-07-09)"

  @@index([referencePriceId, recordedAt])
}

enum RefreshRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// One execution of the scheduled reference-price refresh. This is the
/// monitoring surface for "is the weekly job healthy" (last attempted, last
/// successful, counts, duration) - deliberately one row per run rather than a
/// dashboard, so the question can be answered from the database, the admin
/// API, or a CI log without building a reporting system.
model ReferencePriceRefreshRun {
  id                String           @id @default(uuid())
  source            String // e.g. "cashify"
  /// How the run was started: "schedule" | "manual" | "cli".
  trigger           String           @default("cli")
  status            RefreshRunStatus @default(RUNNING)
  startedAt         DateTime         @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  devicesDiscovered Int              @default(0)
  updatedCount      Int              @default(0)
  unchangedCount    Int              @default(0)
  rejectedCount     Int              @default(0)
  failedCount       Int              @default(0)
  missingCount      Int              @default(0)
  flaggedCount      Int              @default(0)
  /// Devices the run never got to (time cap or an abort). Counted separately
  /// from failures: an unvisited device simply kept its existing price.
  notAttemptedCount Int              @default(0)
  error             String?
  /// The full human-readable report, stored verbatim so an operator can read
  /// exactly what CI printed without needing the CI logs to still exist.
  report            String?

  @@index([startedAt])
  @@index([status, startedAt])
}

/// A mutual-exclusion row so two refresh runs cannot corrupt each other
/// (scheduler retry, an accidental manual trigger during the weekly run, two
/// runners starting at once). Held for a bounded TTL so a crashed run cannot
/// block the pipeline forever.
model ReferencePriceRefreshLock {
  name       String   @id
  holder     String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime
}

/// Which questions Cashify's own "Get Exact Value" questionnaire presents for
/// a model. ASKED / NOT_ASKED / UNKNOWN - never a boolean, because "Cashify
/// does not ask warranty" is a different state from "warranty = No".
enum QuestionnaireMode {
  ASKED
  NOT_ASKED
  UNKNOWN
}

/// Model-level (not RAM/storage-variant) questionnaire semantics, learned by
/// scripts/reference-pricing/refresh-questionnaire-profiles.ts from Cashify's
/// public questionnaire without logging in. Exact-condition pricing reads it;
/// Get Upto never does.
model CashifyQuestionnaireProfile {
  id                String            @id @default(uuid())
  /// "brand|model", lowercased (lib/referencePricing/questionnaire/types.ts).
  modelKey          String            @unique
  brand             String
  model             String
  warrantyMode      QuestionnaireMode @default(UNKNOWN)
  billMode          QuestionnaireMode @default(UNKNOWN)
  ageMode           QuestionnaireMode @default(UNKNOWN)
  /// Question headings seen on the first questionnaire page, for audit.
  questionLabels    String[]
  /// OK | PARSE_FAILED | FETCH_FAILED | NOT_FOUND | VARIANT_MISMATCH
  status            String
  statusDetail      String?
  sourceUrl         String?
  variantsChecked   Int               @default(0)
  parserVersion     String
  observedAt        DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  history           CashifyQuestionnaireProfileHistory[]

  @@index([status])
}

/// Append-only record of every change to a model's questionnaire semantics.
model CashifyQuestionnaireProfileHistory {
  id           String                      @id @default(uuid())
  profileId    String
  profile      CashifyQuestionnaireProfile @relation(fields: [profileId], references: [id])
  warrantyMode QuestionnaireMode
  billMode     QuestionnaireMode
  ageMode      QuestionnaireMode
  status       String
  parserVersion String
  observedAt   DateTime
  recordedAt   DateTime                    @default(now())

  @@index([profileId, recordedAt])
}
