# This file documents every environment variable the server actually reads
# (verified by grepping server/ for process.env usage). No real secrets.
#
# Vars that were previously mentioned here but aren't actually used anywhere
# in the code (MSG91, GCS, Elasticsearch, FCM, Resend, Google OAuth) have
# been removed - see PRODUCTION_READINESS_REPORT.md for the real
# infrastructure status of each. Add them back here when they're actually
# implemented, not before.

# --- Required. The server fails to start without these. ---
JWT_SECRET=replace-with-a-long-random-value
ADMIN_USERNAME=replace-with-a-real-admin-username
# scrypt hash of the admin password - NEVER the password itself. Generate with:
#   npm run admin:hash-password
# (prompts with hidden input and prints only the hash). ADMIN_PASSWORD
# (plaintext) is no longer read; remove it from every environment.
ADMIN_PASSWORD_HASH=scrypt$32768$8$1$replace-with-generated-salt$replace-with-generated-hash

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/fhoneify
# WhatsAppOTP, Lead, and now ReferencePrice/ReferencePriceHistory (see
# PRICING_REFERENCE_DATA_ARCHITECTURE.md) are persisted through Prisma.
# Most other business entities (users/listings/orders/wallet/etc.) are
# still in-memory - see PRODUCTION_READINESS_REPORT.md Phase 5 migration
# plan. If this is unset, the reference-price system automatically falls
# back to a durable file-backed store (fine for local dev, not for a
# scaled production deployment - see PRICING_REFERENCE_DATA_ARCHITECTURE.md
# Section 4).

# --- Reference pricing (see PRICING_REFERENCE_DATA_ARCHITECTURE.md) ---
# REFERENCE_PRICE_WARNING_AGE_DAYS=14
# REFERENCE_PRICE_MAX_AGE_DAYS=30
# REFERENCE_PRICE_MAX_SANE_VALUE=500000
# REFERENCE_PRICE_FLAG_SWING_FRACTION=0.4
# QUOTE_STRICT_REFERENCE_MODE=false
# When true, /api/quote refuses to fabricate a quote for a device with NO
# reference price at all (409 REFERENCE_PRICE_UNAVAILABLE) instead of
# falling back to basePrice. Default false preserves existing behavior -
# turning this on is a product decision, not an engineering default.

# --- Scheduled Cashify refresh (every 7 days) ---
# The weekly job runs on GitHub Actions, NOT on Vercel: a Vercel serverless
# request cannot host a long-running Chromium scrape. See
# .github/workflows/reference-price-refresh.yml.
#
# Required as GitHub repository SECRETS (not committed here):
#   DATABASE_URL           - the same Supabase connection string as above
#   DIRECT_URL             - the same direct (non-pooled) connection string
#   CASHIFY_SESSION_STATE  - base64 of a Playwright storageState JSON, i.e.
#                            `base64 -w0 cashify-sessions/<file>.json`.
#                            Never commit this value; the job writes it to a
#                            0600 file at runtime and never logs its contents.
#
# Optional tuning (defaults shown):
# REFRESH_CONCURRENCY=3              # parallel device pages
# REFRESH_MAX_RETRIES=2              # retries per device on a transport error
# REFRESH_MAX_DURATION_MINUTES=300   # wall-clock cap; devices not reached keep
#                                    # their existing prices and are reported
# REFRESH_TRIGGER=cli                # recorded on the run: schedule|manual|cli
# CASHIFY_SCRAPER_HEADED=false       # true shows the browser, for solving a
#                                    # CAPTCHA by hand LOCALLY. Must stay false
#                                    # anywhere unattended.
# CASHIFY_NAV_TIMEOUT_MS=45000
# CASHIFY_SETTLE_MS=1500
# CASHIFY_PRICE_SETTLE_MS=2000

# --- Authoritative quotes (see PRICING_SYSTEM.md) ---
# Signs price-locked quote tokens. If unset, a key is derived from JWT_SECRET.
# QUOTE_SIGNING_SECRET=generate-a-long-random-value
# QUOTE_TOKEN_TTL_MINUTES=1440
# REFERENCE_PRICE_LOOKUP_TIMEOUT_MS=1500
# Startup warm-up of the reference-price database connection. A failure here
# is logged and non-fatal; quotes fall back to the snapshot until recovery.
# REFERENCE_PRICE_WARMUP_TIMEOUT_MS=10000
# Per-IP limits per 15 minutes.
# QUOTE_PRICE_RATE_LIMIT=120
# QUOTE_LEAD_RATE_LIMIT=20
# QUOTE_MARKET_PRICE_RATE_LIMIT=10
# Live Cashify scraping endpoint; defaults to off in production.
# ENABLE_LIVE_MARKET_PRICE_SCRAPE=false
# Proxies in front of the API (defaults to 1 in production) so rate limits
# key on the real client IP.
# TRUST_PROXY_HOPS=1

# --- Auth ---
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- CORS ---
# Comma-separated list of allowed origins, ADDED to the live storefront origins
# that server/config.ts always allows in production (www.fhoneify.in,
# fhoneify.in, www.fhoneify.com, fhoneify.com, fhoneify-j7vf.vercel.app).
# Those are built in because a stale placeholder here once blocked every
# browser call to the API. The placeholder "https://your-vercel-domain.vercel.app"
# is ignored on purpose.
CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# --- WhatsApp OTP delivery (Meta Graph API - the live OTP path) ---
# All three are REQUIRED for OTP to work. Without them the API returns 503
# rather than pretending a code was sent.
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_OTP_TEMPLATE_NAME=your-approved-template-name
# Must match the template's language EXACTLY as approved in Meta (e.g. "en" vs
# "en_US"); a mismatch makes Meta reject every send with error 132001.
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# WHATSAPP_TIMEOUT_MS=10000
# Webhook verify token: whatever you register in Meta's App Dashboard for
# this webhook. Rotate this if you inherited a repo where it was hardcoded.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-random-value-and-register-it-with-meta

# --- Legacy/alternate OTP paths (see PRODUCTION_READINESS_REPORT.md P1-6 -
# provider consolidation is a pending decision; only one of these should
# ultimately remain) ---
CUNNEKT_BASE_URL=https://app.cunnekt.com/restapi/v1/whatsapp/
CUNNEKT_API_KEY=your-cunnekt-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# --- Payments: NOT YET IMPLEMENTED. Do not set these expecting real payment
# verification - server/modules/payments/service.ts does not call Razorpay
# at all yet. See PRODUCTION_READINESS_REPORT.md Phase 8 plan. ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- White-label partner API ---
WHITE_LABEL_API_KEY=generate-a-real-random-key-per-partner

# --- Redis: NOT YET IMPLEMENTED as real Redis (in-process mock only). Set
# this once Phase 6 (real Redis) is implemented. ---
# REDIS_URL=redis://localhost:6379

# --- Misc ---
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
