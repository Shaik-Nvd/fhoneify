{
  "name": "fhoneify",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "next dev -p 3000",
    "dev:api": "tsx watch server/server.ts",
    "build": "next build",
    "start": "next start",
    "start:api": "npx prisma db push && tsx server/server.ts",
    "lint": "next lint",
    "setup-cashify": "node scripts/setup-cashify.js",
    "postinstall": "npx playwright install chromium"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.6.7",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "framer-motion": "^12.40.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^14.1.0",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "prisma": "^5.14.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "tsx": "^4.7.0",
    "twilio": "^6.0.2",
    "typescript": "^5.3.3",
    "zod": "^4.4.3",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1"
  }
}
